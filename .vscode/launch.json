    "version": "0.2.0",
    "configurations": [
        {
            "name": "patch-press - scan-from-probe Dexed",
            "type": "debugpy",
            "request": "launch",
            "module": "patch_press.cli",
            "args": [
                "--debug",
                "scan-from-probe",
                "/home/blablack/src/patch-probe/output/Dexed",
                "output/Configs/Dexed",
                "--quality",
                "low"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "patch-press: scan-from-probe Odin2",
            "type": "debugpy",
            "request": "launch",
