    "version": "0.2.0",
    "configurations": [
        {
            "name": "patch-press: scan-from-probe Dexed",
            "type": "debugpy",
            "request": "launch",
            "module": "patch_press.cli",
            "args": [
                "--debug",
                "scan-from-probe",
                "/home/blablack/src/patch-press/input/Probes/Dexed",
                "output/Configs/Dexed",
                "--quality",
                "medium"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "patch-press: scan-from-probe Odin2",
            "type": "debugpy",
            "request": "launch",
            "module": "patch_press.cli",
            "args": [
                "--debug",
                "scan-from-probe",
                "/home/blablack/src/patch-press/input/Probes/Odin2",
                "output/Configs/Odin2",
                "--quality",
                "medium"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "patch-press: scan-clap Surge XT",
            "type": "debugpy",
            "request": "launch",
            "module": "patch_press.cli",
            "args": [
                "--debug",
                "scan-clap",
                "input/Plugins/Surge XT.clap",
                "/home/blablack/Surge XT/Basses",
                "output/Configs/Surge XT",
                "--quality",
                "medium"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "patch-press: scan library",
            "type": "debugpy",
            "request": "launch",
            "module": "patch_press.cli",
            "args": [
                "--debug",
                "scan-library",
                "input/Mini From Mars",
                "output/Configs/Mini From Mars",
                "--type",
                "multisample"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },        
        {
            "name": "patch-press: batch Dexed",
            "type": "debugpy",
            "request": "launch",
            "module": "patch_press.cli",
            "args": [
                "--debug",
                "batch",
                "output/Configs/Dexed/*.yaml",
                "--path",
                "output/Deluge/Dexed",
                "--format",
                "deluge",
                "--workers",
                "4"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false
        },
        {
            "name": "patch-press: batch Odin2",
            "type": "debugpy",
